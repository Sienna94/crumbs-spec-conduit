+POST {{host}}/api/users/login
+{
+  "user": {
+    "email": "ea_dup_{{uid}}@",
+    "password": "password123"
+  }
+}
+HTTP 422
+[Asserts]
+jsonpath "$.errors.email[0]" == "is invalid"
+
 # Login wrong password
 POST {{host}}/api/users/login
 {
@@ -139,6 +164,18 @@ Authorization: Token {{token}}
 }
